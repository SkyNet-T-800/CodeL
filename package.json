{
  "name": "codel",
  "version": "0.1.0",
  "private": true,
  "description": "Week 1 reference implementation of a deterministic coding-agent runtime skeleton.",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsx apps/cli/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:w1": "pnpm build && pnpm exec codel run --task fixtures/hello-repo/task.json --sessions-dir .sessions --session-id fixture-readme-run --run-id fixture-readme-run",
    "smoke:w3": "pnpm build && node scripts/run-w3-smoke.mjs --provider scripted",
    "smoke:w3:real": "pnpm build && node scripts/run-w3-smoke.mjs --provider openai",
    "smoke:w3:deepseek": "pnpm build && node scripts/run-w3-smoke.mjs --provider deepseek --max-steps 8",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@codel/cli": "workspace:*",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
