{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-circuit.dev/schemas/run-meta.schema.json",
  "title": "RepoCircuit Run Meta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "comparisonId",
    "attemptIndex",
    "identity",
    "model",
    "prompt",
    "tools",
    "context",
    "budget",
    "evaluation",
    "outcome",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "comparisonId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptIndex": {
      "type": "integer",
      "minimum": 0
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "baseSha",
        "fixtureVersion",
        "startedAt",
        "agentCommit",
        "harnessCommit"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "minLength": 1
        },
        "fixtureVersion": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "agentCommit": {
          "type": "string",
          "minLength": 1
        },
        "harnessCommit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId",
        "modelRevision",
        "reasoningEffort",
        "temperature",
        "topP",
        "seed"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "modelRevision": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "const": "unknown"
            },
            {
              "const": "unsupported"
            }
          ]
        },
        "topP": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "const": "unknown"
            },
            {
              "const": "unsupported"
            }
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "const": "unknown"
            },
            {
              "const": "unsupported"
            }
          ]
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemPromptHash"
      ],
      "properties": {
        "systemPromptHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolSchemaHash",
        "enabledTools",
        "toolPolicyHash"
      ],
      "properties": {
        "toolSchemaHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "enabledTools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "toolPolicyHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextStrategy",
        "maxContextTokens"
      ],
      "properties": {
        "contextStrategy": {
          "type": "string",
          "minLength": 1
        },
        "maxContextTokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "unsupported"
            }
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSteps",
        "tokenBudget",
        "maxToolCalls",
        "wallClockBudgetMs"
      ],
      "properties": {
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1
        },
        "wallClockBudgetMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierVersion",
        "evaluatorCommit",
        "scorer"
      ],
      "properties": {
        "verifierVersion": {
          "type": "string",
          "minLength": 1
        },
        "evaluatorCommit": {
          "type": "string",
          "minLength": 1
        },
        "scorer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endedAt",
        "usage",
        "steps",
        "toolCallCount",
        "latencyMs",
        "terminalReason",
        "patchHash",
        "testResult"
      ],
      "properties": {
        "endedAt": {
          "type": "string",
          "minLength": 1
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputTokens",
            "outputTokens",
            "totalTokens",
            "complete"
          ],
          "properties": {
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "totalTokens": {
              "type": "integer",
              "minimum": 0
            },
            "complete": {
              "type": "boolean"
            }
          }
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "toolCallCount": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "terminalReason": {
          "type": "string",
          "minLength": 1
        },
        "patchHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "testResult": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "exitCode",
            "summary",
            "durationMs"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_run",
                "infra_error"
              ]
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracePath",
        "traceSha256",
        "patchPath",
        "patchSha256",
        "verifierResultPath",
        "verifierResultSha256"
      ],
      "properties": {
        "tracePath": {
          "type": "string",
          "minLength": 1
        },
        "traceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patchPath": {
          "type": "string",
          "minLength": 1
        },
        "patchSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifierResultPath": {
          "type": "string",
          "minLength": 1
        },
        "verifierResultSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
